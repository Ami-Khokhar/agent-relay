{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory.local/schemas/result.schema.json",
  "title": "Result",
  "description": "A worker's artifact handoff. The control path consumes the artifact (branch + commit + evidence), never the free-text notes. This is what makes the factory harness-agnostic: any harness that can commit is a valid worker.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workOrderId", "status", "startedAt", "finishedAt"],
  "properties": {
    "schemaVersion": { "const": "factory.result/v1" },
    "workOrderId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["completed", "failed", "timed_out", "cancelled"] },
    "artifact": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["branch", "commitSha"],
          "properties": {
            "branch": { "type": "string", "minLength": 1 },
            "commitSha": { "type": "string", "minLength": 1 },
            "filesChanged": { "type": "array", "items": { "type": "string" } }
          }
        }
      ]
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" }
    },
    "usage": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tokens": { "type": ["integer", "null"] },
            "usd": { "type": ["number", "null"] },
            "provider": { "type": ["string", "null"] },
            "model": { "type": ["string", "null"] }
          }
        }
      ]
    },
    "session": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "handle": { "type": "string" },
            "native": { "type": "boolean" }
          }
        }
      ]
    },
    "error": { "type": ["string", "null"] },
    "notes": {
      "type": ["string", "null"],
      "description": "Free text for humans. NONE of the control path may parse this."
    },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "completed" } }, "required": ["status"] },
      "then": { "required": ["artifact"], "properties": { "artifact": { "type": "object" } } }
    },
    {
      "if": {
        "properties": { "status": { "enum": ["failed", "timed_out"] } },
        "required": ["status"]
      },
      "then": { "required": ["error"], "properties": { "error": { "type": "string", "minLength": 1 } } }
    }
  ],
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "command", "exit"],
      "properties": {
        "kind": { "enum": ["test", "lint", "typecheck", "build", "scan", "proof"] },
        "command": { "type": "string", "minLength": 1 },
        "exit": { "type": "integer" },
        "tail": { "type": ["string", "null"] }
      }
    }
  }
}
