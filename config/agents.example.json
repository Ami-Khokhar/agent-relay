{
  "roles": {
    "reviewer": {
      "description": "Reviews a change against the intent that was stated and reports defects; never edits.",
      "promptFile": "../prompts/roles/reviewer.md",
      "inputHeader": "Review this work:"
    },
    "implementer": {
      "description": "Implements the stated change and proves it with a real check.",
      "promptFile": "../prompts/roles/implementer.md"
    }
  },
  "agents": [
    { "id": "claude", "name": "Claude Code", "command": "claude", "args": ["--print"], "cwd": "/path/to/project" },
    { "id": "codex", "name": "Codex", "command": "codex", "args": ["exec", "--skip-git-repo-check", "-s", "workspace-write"], "cwd": "/path/to/git/project", "allowedRoots": ["/path/to/git/project", "/path/to/another/project"], "options": { "network": { "off": [], "on": ["-c", "sandbox_workspace_write.network_access=true"] } } },
    { "id": "pi", "name": "Pi", "command": "pi", "args": ["--print"], "cwd": "/path/to/project" },
    { "id": "pi-reviewer", "name": "Pi (reviewer role)", "description": "Same harness, told to review rather than implement.", "command": "pi", "args": ["--print"], "cwd": "/path/to/project", "role": "reviewer" },
    { "id": "opencode", "name": "OpenCode", "command": "opencode", "args": ["run"], "cwd": "/path/to/project" },
    { "id": "opencode-implementer", "name": "OpenCode (implementer role)", "description": "Same harness, told to implement and prove the change.", "command": "opencode", "args": ["run"], "cwd": "/path/to/project", "role": "implementer" },
    { "id": "wrapped", "name": "Any wrapped harness", "type": "stdio", "command": "python3", "args": ["/path/to/adapter.py"], "cwd": "/path/to/project" },
    { "id": "hosted", "name": "Harness on its own port", "type": "http", "url": "http://127.0.0.1:9000/run" }
  ]
}
